generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 字串欄位之類型常數定義於 src/lib/types.ts（enum-as-string 模式，SQLite 相容性遺留，沿用）。

// ════════════════════════════════════════════
// 帳號與機關
// ════════════════════════════════════════════

model Organization {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  shortName   String?
  parentId    String?
  parent      Organization?  @relation("OrgTree", fields: [parentId], references: [id])
  children    Organization[] @relation("OrgTree")
  users       User[]
  cycles      AuditCycle[]
  invitations Invitation[]
  createdAt   DateTime       @default(now())
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           String // Role: SUPER_ADMIN | ORG_ADMIN | AUDITOR
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean       @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())

  // 帳號生命週期 + 權責分立:停用須附理由與操作者(快照,無關聯;比照 JourneyProgress.doneById)
  disabledAt     DateTime?
  disabledById   String? // 停用操作者 id 快照
  disabledByName String? // 停用操作者姓名快照
  disableReason  String? // 停用理由(權責分立稽核軌跡)

  // 資通系統防護基準(中級)— SECURITY_BASELINE 旗標啟用後生效
  failedLoginCount   Int       @default(0) // 連續登入失敗次數(成功即歸零)
  lockedUntil        DateTime? // 鎖定截止(失敗 5 次鎖 15 分鐘)
  passwordChangedAt  DateTime? // 密碼最後變更時間(效期計算)
  mustChangePassword Boolean   @default(false) // 強制變更(初始密碼/逾效期)
  passwordHistory    String? // JSON:最近 3 個 bcrypt 雜湊(禁止重用)

  auditorAssignments   AuditorAssignment[]
  auditScores          AuditScore[]
  auditFindings        AuditFinding[]
  cycleTransitions     CycleStateTransition[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  reviewedDeficiencies Deficiency[]           @relation("DeficiencyReviewer")
  // 觀察員(批30):被配對之週期 / 擔任指導委員之配對 / 練習發現 / 指導回饋
  observerAssignments  CycleObserver[]        @relation("ObserverAssignments")
  mentorAssignments    CycleObserver[]        @relation("MentorAssignments")
  practiceFindings     PracticeFinding[]      @relation("PracticeFindings")
  practiceFeedbacks    PracticeFeedback[]     @relation("PracticeFeedbacks")
  // 多重身分授權(批31):此帳號「可用的身分集合」;User.role 語義=現用身分(見 UserRole 註解)
  roleGrants           UserRole[]
}

// ════════════════════════════════════════════
// 多重身分授權(批31):同一人可兼「機關管理員+觀察員+稽核委員」。
// UserRole = 此帳號可切換的身分集合;User.role/organizationId = 「現用身分」。
// 切換(POST /api/identity/switch)= 驗證授權後改寫 User.role/organizationId,
// 騎乘 auth.ts jwt callback「每請求回查 DB」機制,下一請求 session 即生效(零 NextAuth 改造)。
// 相容:無任何 UserRole 列的既有帳號 = 單一身分(視 User.role 為隱含授權),不顯示切換選單。
// 收回不硬刪(endedAt 蓋章留歷史,權責分立);晉升觀察員→委員 = 結束 OBSERVER 授權+新增 AUDITOR 授權。
// ════════════════════════════════════════════

model UserRole {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String // SUPER_ADMIN | ORG_ADMIN | AUDITOR | OBSERVER
  organizationId String? // ORG_ADMIN 必填(機關綁定);其餘角色 null
  createdAt      DateTime  @default(now())
  createdById    String // 授予者 id 快照(權責分立)
  endedAt        DateTime? // 收回/晉升結束時間(null=有效)

  @@index([userId, endedAt])
}

// 忘記密碼/管理員重設:一次性重設 token(存 SHA-256 雜湊,明文只放連結);單次使用、有期限。
model PasswordResetToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique // SHA-256(明文 token);查詢用雜湊比對,DB 不存明文
  expiresAt        DateTime // 自助 1h / 管理員 24h
  usedAt           DateTime? // 消費後蓋章,單次使用
  createdByAdminId String? // 管理員手動觸發時記錄操作者;自助則 null
  createdAt        DateTime  @default(now())

  @@index([userId])
}

// 站內通知(鈴鐺):每封寄給系統使用者的信同步建立一筆,避免委員/機關漏看 email。
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // 對應 EmailKind
  title     String // = 信件主旨(去 [MOECISH] 前綴)
  body      String? // 摘要(信件主要內容段)
  link      String? // 站內連結(多為 /cycles/...)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Invitation {
  id             String        @id @default(cuid())
  token          String        @unique
  email          String
  name           String
  role           String // Role
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String
  expiresAt      DateTime
  usedAt         DateTime?
  userId         String?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([email])
  @@index([organizationId])
}

// ════════════════════════════════════════════
// 前台公告（模組 A，P3 啟用 — schema 先到位）
// ════════════════════════════════════════════

model Post {
  id          String           @id @default(cuid())
  slug        String           @unique
  category    String // PostCategory: ANNOUNCEMENT | INTEL | VULN_ALERT | EVENT
  title       String
  contentMd   String
  coverKey    String?
  important   Boolean          @default(false)
  pinned      Boolean          @default(false)
  status      String           @default("DRAFT") // PostStatus: DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime? // 上架時間(批33:可排程未來=「待發布」;visible 需 status=PUBLISHED 且 publishedAt<=now)
  unpublishAt DateTime? // 排定下架時間(批33:到時自動下架=查詢時間窗判定,免排程器;null=不自動下架)
  authorId    String
  attachments PostAttachment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, category, publishedAt])
}

model PostAttachment {
  id         String @id @default(cuid())
  postId     String
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileName   String
  storageKey String
  mimeType   String
  sizeBytes  Int
}

// ════════════════════════════════════════════
// 稽核週期
// ════════════════════════════════════════════

model AuditCycle {
  id                  String           @id @default(cuid())
  year                Int
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id])
  checklistVersionId  String // 沿用（檢核表模組保留為選用功能）
  checklistVersion    ChecklistVersion @relation(fields: [checklistVersionId], references: [id])
  status              String           @default("DRAFT") // CycleStatus 2.0
  startDate           DateTime
  dueDate             DateTime? // 矯正填報截止(實地稽核/發文後再設;可不填)
  prepDueDate         DateTime? // 資料準備(實地稽核區)繳交截止
  prepDueTech         DateTime? // 資料準備(技術檢測區)繳交截止(可與實地稽核不同)
  techCheckDate       DateTime? // 技術檢測日(執行技術檢測之日期;通常早於實地稽核日)
  onsiteDate          DateTime?
  // 委員審閱時間區間(UAT 批67):中心設定「開放委員檢視機關資料(資料準備+檢核表審閱)」的時段。
  // 未設(任一端 null)→ 委員一律不可見(使用者裁定「沒設區間就不開放」);設了 → 僅 [start,end] 內開放。
  reviewWindowStart   DateTime?
  reviewWindowEnd     DateTime?
  // 觀察員獨立審閱窗口(批30 需求一-1):與委員窗口平行的第二組區間,語義相同(未設=不開放)。
  observerWindowStart DateTime?
  observerWindowEnd   DateTime?
  closedAt            DateTime?
  version             Int              @default(0)

  // 檢核表填報閉環:機關送出後鎖定,委員/管理員可退回重填
  checklistSubmittedAt DateTime?
  checklistSubmittedBy String? // 送出者姓名快照
  checklistReopenNote  String? // 最近一次退回原因(重新送出時清空)

  // 實地稽核報告頁首設定(JSON:稽核日期/範圍/準則/領隊/副領隊/三面團隊)
  auditReportMeta String?

  responses        ChecklistResponse[]
  deficiencies     Deficiency[]
  signedReports    SignedReport[]
  prepRequirements PrepRequirement[]
  stateTransitions CycleStateTransition[]
  assignments      AuditorAssignment[]
  auditScores      AuditScore[]
  auditFindings    AuditFinding[]
  journeyProgress  JourneyProgress[]
  observers        CycleObserver[]
  practiceFindings PracticeFinding[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([organizationId, year])
}

// ════════════════════════════════════════════
// 實地稽核(附件17):委員評分 + 稽核發現
// ════════════════════════════════════════════

// 委員實地稽核評分:每委員 × 每週期 × 九稽核項目(= 檢核表九構面)一筆
model AuditScore {
  id           String     @id @default(cuid())
  cycleId      String
  cycle        AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  auditorId    String
  auditor      User       @relation(fields: [auditorId], references: [id])
  dimension    String // Dimension(一~九,七配分 20 其餘 10)
  score        Int? // 委員評分(null=尚未評;可僅填檢核數量)
  // 委員手動判定之檢核結果數量(預設空白;彙整/列印依此呈現,不再自動帶機關自評)
  cntComply    Int? // 符合
  cntPartial   Int? // 部分符合
  cntNonComply Int? // 不符合
  cntNa        Int? // 不適用
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([cycleId, auditorId, dimension])
  @@index([cycleId])
}

// 委員稽核發現(稽核當天逐條輸入;自動彙整;待改善/建議可一鍵轉入缺失管考)
model AuditFinding {
  id           String     @id @default(cuid())
  cycleId      String
  cycle        AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  auditorId    String
  auditor      User       @relation(fields: [auditorId], references: [id])
  aspect       String // STRATEGY | MANAGEMENT | TECHNICAL
  kind         String // COMPLIANCE(法遵符合)| IMPROVE(待改善)| SUGGEST(建議)
  content      String
  checklistRef String? // 對應檢核項次(選填,如 "7.4")
  deficiencyId String? // 轉入缺失管考後回填(鎖定編輯)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([cycleId, aspect, kind])
}

// 稽核發現「剪貼簿」片語庫(最高管理員維護;委員於實地稽核發現表單依構面/類型篩選後一鍵插入)
// aspect/kind 留空("")= 通用,任何構面/類型皆會列出。
model FindingSnippet {
  id         String   @id @default(cuid())
  aspect     String   @default("") // STRATEGY | MANAGEMENT | TECHNICAL | ""(通用)
  kind       String   @default("") // COMPLIANCE | IMPROVE | SUGGEST | ""(通用)
  text       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([aspect, kind])
}

model AuditorAssignment {
  id            String     @id @default(cuid())
  cycleId       String
  cycle         AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  auditorId     String
  auditor       User       @relation(fields: [auditorId], references: [id])
  role          String     @default("MEMBER") // LEAD / MEMBER
  // 指派負責稽核構面(JSON 陣列;AssignAspect:STRATEGY/MANAGEMENT/MANAGEMENT_OT/TECHNICAL)。
  // 純指派標籤,不更動附件17 的 9 項評分結構;null/空=未指定(視同全構面)。
  dimensions    String?
  reviewDoneAt  DateTime? // 委員按「檢核表意見填寫完成」的時間(供中心掌握審閱進度)
  // 委員按「確認填寫完畢」鎖定其評分與稽核發現的時間;鎖定後不可改,解除鎖定會通知最高管理員。
  scoreLockedAt DateTime?
  createdAt     DateTime   @default(now())

  @@unique([cycleId, auditorId])
}

// ════════════════════════════════════════════
// 觀察員(批30):師徒制實習。觀察員配對「絕不」進 AuditorAssignment
// (全站以「在指派表中」判定委員權力,混入即繼承委員權限;此表為顯式授予,fail-closed)。
// ════════════════════════════════════════════

model CycleObserver {
  id         String     @id @default(cuid())
  cycleId    String
  cycle      AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  observerId String
  observer   User       @relation("ObserverAssignments", fields: [observerId], references: [id])
  // 指導委員(師徒制,需求二-3):必須是本週期 AuditorAssignment 中的正式委員(API 驗證;
  // 委員被抽換前需先改配對)。指導委員可檢視「自己帶的」觀察員練習並回饋。
  mentorId   String
  mentor     User       @relation("MentorAssignments", fields: [mentorId], references: [id])
  createdAt  DateTime   @default(now())

  @@unique([cycleId, observerId])
  @@index([cycleId, mentorId])
}

// 練習發現(需求二-2 硬隔離):獨立資料表=結構性保證「絕不代入彙整工具/正式報告/缺失管考」——
// buildReportData/彙整/列印/Word/缺失匯入全部只讀 AuditFinding,本表無 deficiencyId、無任何報告端消費者。
// 可見範圍:觀察員本人(讀寫own)/指導委員(讀+回饋)/中心(唯讀監督);機關完全不可見。
model PracticeFinding {
  id           String             @id @default(cuid())
  cycleId      String
  cycle        AuditCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  observerId   String
  observer     User               @relation("PracticeFindings", fields: [observerId], references: [id])
  aspect       String // STRATEGY | MANAGEMENT | TECHNICAL(與正式發現同結構,練習才有意義)
  kind         String // COMPLIANCE | IMPROVE | SUGGEST
  content      String
  checklistRef String? // 對應檢核項次(選填,如 "7.4")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  feedbacks    PracticeFeedback[]

  @@index([cycleId, observerId])
}

// 指導委員對單條練習發現的回饋(文字);刪除練習發現時級聯刪除。
model PracticeFeedback {
  id                String          @id @default(cuid())
  practiceFindingId String
  practiceFinding   PracticeFinding @relation(fields: [practiceFindingId], references: [id], onDelete: Cascade)
  mentorId          String
  mentor            User            @relation("PracticeFeedbacks", fields: [mentorId], references: [id])
  content           String
  createdAt         DateTime        @default(now())
}

model CycleStateTransition {
  id         String     @id @default(cuid())
  cycleId    String
  cycle      AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String
  actor      User       @relation(fields: [actorId], references: [id])
  reason     String?
  createdAt  DateTime   @default(now())
}

// ════════════════════════════════════════════
// 模組 B：稽核前資料準備（P2 啟用 — schema 先到位）
// ════════════════════════════════════════════

model PrepTemplate {
  id        String             @id @default(cuid())
  name      String
  items     PrepTemplateItem[]
  createdAt DateTime           @default(now())
}

model PrepTemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    PrepTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  required    Boolean            @default(true)
  category    String             @default("ONSITE") // 同 PrepCategory(TECH/ONSITE/CENTER)
  year        Int? // 年度分類(西元,同 AuditCycle.year;null=通用逐年皆帶)。套用時取「該年度+通用」,年度同名優先
  orderIndex  Int
  files       PrepTemplateFile[]
}

// 資料準備清單「文件範本」:中心上傳供機關下載依式填寫(僅此處允許 Word/Excel 等可編輯格式;
// 機關佐證上傳仍限 PDF/JPG/PNG)。掛在年度化的清單項目上=歷年範本隨年度項目自然保存。
model PrepTemplateFile {
  id           String           @id @default(cuid())
  itemId       String
  item         PrepTemplateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  sha256       String
  uploadedById String
  uploadedAt   DateTime         @default(now())

  @@index([itemId])
}

model PrepRequirement {
  id          String          @id @default(cuid())
  cycleId     String
  cycle       AuditCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  required    Boolean         @default(true)
  // PrepCategory:TECH(技術檢測)| ONSITE(實地稽核)| CENTER(中心匯入,中心上傳、無機關繳交)
  category    String          @default("ONSITE")
  orderIndex  Int
  submission  PrepSubmission?
}

model PrepSubmission {
  id            String          @id @default(cuid())
  requirementId String          @unique
  requirement   PrepRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  // PrepStatus: EMPTY(未處理) | UPLOADED(待繳交/草稿) | SUBMITTED(機關已確定繳交,鎖定) | CONFIRMED(中心確認齊備) | INSUFFICIENT(中心退回補正)
  status        String          @default("EMPTY")
  note          String?
  noFileReason  String? // 無相關文件時的敘述理由(與檔案二擇一即視為已處理)
  submittedAt   DateTime? // 機關「確定繳交」時間
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  updatedAt     DateTime        @updatedAt
}

// ════════════════════════════════════════════
// 模組 C：缺失發布與矯正管考（P1 核心）
// 結構 1:1 對齊教育部「資通安全稽核改善暨執行情形報告」範本
// ════════════════════════════════════════════

model Deficiency {
  id                String            @id @default(cuid())
  cycleId           String
  cycle             AuditCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  aspect            String // DeficiencyAspect: STRATEGY | MANAGEMENT | TECHNICAL（構面）
  type              String // DeficiencyType: IMPROVE（待改善事項）| SUGGEST（建議事項）
  itemNo            Int // 構面 × 類型內之項次
  description       String // 缺失全文（含法源引用）
  checklistRef      String? // 檢核項參照，如 "9.10"
  action            CorrectiveAction?
  createdById       String
  // 審閱委員:由中心(SUPER_ADMIN)於「相關開立委員」中指派;null=尚未指派。
  // 審核權限(審核通過/退回補正)= 此委員 或 SUPER_ADMIN(見 action/review)。
  reviewerAuditorId String?
  reviewerAuditor   User?             @relation("DeficiencyReviewer", fields: [reviewerAuditorId], references: [id])
  createdAt         DateTime          @default(now())

  @@unique([cycleId, aspect, type, itemNo])
  @@index([cycleId, aspect])
}

model CorrectiveAction {
  id                String     @id @default(cuid())
  deficiencyId      String     @unique
  deficiency        Deficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)
  status            String     @default("PENDING")
  // ActionStatus: PENDING（待填報）| DRAFT（填寫中）| SUBMITTED（已送審）| RETURNED（退回補正）| PASSED（審核通過）
  round             Int        @default(1)
  rootCause         String? // 發生原因（根因分析）
  measureStrategy   String? // 改善措施 — 策略面調整說明（null = 未勾選）
  measureManagement String? // 改善措施 — 管理面調整說明
  measureTechnical  String? // 改善措施 — 技術面調整說明
  plannedDate       DateTime? // 預計完成時程
  trackingMethod    String? // 進度追蹤方式
  execStatus        String? // ExecStatus: ON_TIME_DONE | IN_PROGRESS | LATE_DONE | LATE_IN_PROGRESS
  actualDate        DateTime? // 實際完成日期（如期完成/逾期完成）
  extendedDate      DateTime? // 預計完成日期延長至（逾期辦理中）
  delayReason       String? // 逾期原因
  submittedAt       DateTime?
  updatedAt         DateTime   @updatedAt

  reviews ReviewRecord[]
}

model ReviewRecord {
  id        String           @id @default(cuid())
  actionId  String
  action    CorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  round     Int
  decision  String // ReviewDecisionValue: PASS | RETURN
  comment   String?
  snapshot  String? // 審查當下機關填報內容快照(JSON 字串,多輪比對用)
  auditorId String
  decidedAt DateTime         @default(now())

  @@index([actionId, round])
}

model SignedReport {
  id            String     @id @default(cuid())
  cycleId       String
  cycle         AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  fileKey       String
  fileName      String
  sha256        String
  uploadedById  String
  uploadedAt    DateTime   @default(now())
  submittedById String? // 機關「確認繳交」鎖定此掃描檔為正式繳交版本;null=草稿(可換版/再上傳)
  submittedAt   DateTime?
  confirmedById String?
  confirmedAt   DateTime?

  @@index([cycleId])
}

// ════════════════════════════════════════════
// 檢核表模組（保留為選用功能，2.0 預設不顯示於導航）
// ════════════════════════════════════════════

model ChecklistVersion {
  id          String          @id @default(cuid())
  year        Int // 同年度可有多版本(如行政院公務機關版/醫療深度版)
  name        String
  publishedAt DateTime?
  isActive    Boolean         @default(false)
  items       ChecklistItem[]
  cycles      AuditCycle[]

  @@index([year])
}

model ChecklistItem {
  id               String              @id @default(cuid())
  versionId        String
  version          ChecklistVersion    @relation(fields: [versionId], references: [id])
  dimension        String
  itemNo           String
  content          String
  // 法規對照(教育部醫療資安推動中心彙整;逐字法條引錄)
  auditBasis       String? // 稽核依據:法規條文逐字
  auditFocus       String? // 稽核重點
  expectedEvidence String? // 佐證資料(機關應備文件)
  orderIndex       Int
  responses        ChecklistResponse[]

  @@unique([versionId, itemNo])
  @@index([versionId, dimension])
}

model ChecklistResponse {
  id              String        @id @default(cuid())
  cycleId         String
  cycle           AuditCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id])
  compliance      String?
  description     String? // 簡述規範內容、執行方式、執行結果
  recordDocs      String? // 紀錄文件(如規範、紀錄、公文等)
  orgRevisionNote String? // 機關對委員意見的「補正回應」(與原填答區隔;有委員意見時可填)
  version         Int           @default(0)
  lastEditorId    String?
  lastEditedAt    DateTime?
  createdAt       DateTime      @default(now())

  comments AuditorComment[]

  @@unique([cycleId, checklistItemId])
}

model AuditorComment {
  id           String            @id @default(cuid())
  responseId   String
  response     ChecklistResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  auditorId    String
  content      String
  round        Int
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime          @default(now())

  @@index([responseId, round])
}

// ════════════════════════════════════════════
// 模組 D：通知（EmailTemplate 為 P2，EmailLog 沿用）
// ════════════════════════════════════════════

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // prep-insufficient | action-returned | due-soon | overdue | quarterly | invitation
  subject   String
  bodyMd    String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// 信件範本庫（LetterTemplate）：後台可編輯的公文/通知底稿，供產生器帶入變數→複製富文字貼到外部郵件用戶端寄送。
// 移植自「信件範本工具」；templateKey 對應工具原編號（seed 冪等鍵）。不接管平台 HTML 寄信管線。
model LetterTemplate {
  id            String   @id @default(cuid())
  templateKey   String   @unique // 對應工具原 id（如 "7"），seed 冪等鍵
  category      String // 逗號分隔雙標籤，如「委員作業, 稽核-準備作業」
  workflowOrder Int      @default(99) // 作業流程排序（1X 準備 / 2X 實地 / 3X 檢討 / 4XX 研討）
  subGroup      String? // 子分組（如「稽核委員共識會議」）
  title         String
  attachment    String   @default("無") // 附件說明（非實體檔，供承辦備忘）
  audience      String   @default("") // 收件對象說明
  subject       String   @db.Text // 主旨（含 {{變數}}）
  content       String   @db.Text // 內文（純文字 + 內嵌 HTML + {{變數}} + {{表格_XXX}}）
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workflowOrder])
}

model EmailLog {
  id                  String    @id @default(cuid())
  toEmail             String
  toName              String?
  subject             String
  body                String
  kind                String // "invitation" | "cycle-notify" | "tracking" | "password-reset" | "other"
  context             String? // JSON
  // 投遞狀態(可查詢欄;與 context.delivery 同步,供死信補寄 timer 掃描):
  // sent | failed | simulated | skipped | dead-letter(自動重試達上限)
  status              String    @default("sent")
  retryCount          Int       @default(0) // 自動補寄已嘗試次數
  lastRetryAt         DateTime? // 最近一次補寄時間(冷卻計算)
  templateKey         String?
  relatedInvitationId String?
  relatedCycleId      String?
  sentAt              DateTime  @default(now())

  @@index([sentAt])
  @@index([toEmail])
  @@index([kind])
  @@index([status])
}

// ════════════════════════════════════════════
// 引導式精靈（Guided Journey）：各階段可勾選的 SOP / checklist
//   範本（Template→Stage→Item）可在後台編輯；進度（Progress）可勾選、存檔。
//   scope = CYCLE（每家醫院一個週期，依 7 狀態階段、分角色） | PROGRAMME（中心年度計畫執行，依年度綁定）。
//   結構對齊既有 PrepTemplate→PrepRequirement→PrepSubmission（範本→實例→狀態）。
// ════════════════════════════════════════════

model JourneyTemplate {
  id        String         @id @default(cuid())
  scope     String         @unique // JourneyScope: CYCLE | PROGRAMME（每 scope 單一啟用範本）
  title     String
  stages    JourneyStage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model JourneyStage {
  id         String          @id @default(cuid())
  templateId String
  template   JourneyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stageKey   String // CYCLE：CycleStatus（DRAFT..CLOSED）；PROGRAMME：自訂 key
  title      String
  summary    String?
  startDate  DateTime? // 開始日期(中心年度計畫執行 PROGRAMME 排程用;週期各階段 CYCLE 不使用)
  dueDate    DateTime? // 截止日期(同上;「何時之前要完成」)
  orderIndex Int
  items      JourneyItem[]

  @@unique([templateId, stageKey]) // 同範本內 stageKey 不重複（防雙開/重複計數）
  @@index([templateId])
}

model JourneyItem {
  id            String            @id @default(cuid())
  stageId       String
  stage         JourneyStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  title         String
  hint          String? // 附註 / 文件位置 / 提示
  role          String? // CYCLE：限定角色（null = 全體）；PROGRAMME：null
  // CYCLE 專用:此項對應的「系統動作」鍵 → 由 lib/journey-auto.ts 規則依週期實況自動判定完成。
  // 完成判定三型:autoKey 非空=系統自動;autoKey 空+informational=false=必做・手動勾選(JourneyProgress);
  // informational=true=純提醒(不勾選不計分)。PROGRAMME 的 informational 亦適用。
  autoKey       String?
  informational Boolean           @default(false) // 純提醒項:不顯示勾選框、不計入進度
  href          String? // CYCLE 快捷跳轉覆寫(相對週期子路徑或錨點;null=依 journeyItemHref 系統推導)
  orderIndex    Int
  progress      JourneyProgress[]

  @@index([stageId])
}

model JourneyProgress {
  id            String      @id @default(cuid())
  itemId        String
  item          JourneyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cycleId       String? // CYCLE scope 綁定
  cycle         AuditCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  programmeYear Int? // PROGRAMME scope 綁定（一律存民國年 ROC，例 115；由 API 驗證 101–199）
  done          Boolean     @default(false)
  doneAt        DateTime?
  doneById      String? // 勾選者 id（快照，無關聯）
  doneByName    String? // 勾選者姓名快照
  note          String?
  updatedAt     DateTime    @updatedAt

  @@unique([itemId, cycleId])
  @@unique([itemId, programmeYear])
  @@index([cycleId])
  @@index([programmeYear])
}

// ════════════════════════════════════════════
// 共用：佐證附件 / 審計軌跡
// ════════════════════════════════════════════

model Evidence {
  id           String   @id @default(cuid())
  targetType   String // EvidenceTargetType: CHECKLIST_RESPONSE | CORRECTIVE_ACTION | PREP_SUBMISSION | AUDIT_CYCLE
  targetId     String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  sha256       String
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  ipAddress  String?
  userAgent  String?
  chainHash  String? // 雜湊鏈(防護基準中級:日誌完整性)= sha256(前筆 chainHash + 本筆內容)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
