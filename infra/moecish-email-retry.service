[Unit]
Description=MOECISH dead-letter email retry (re-send failed notifications)
After=network.target postgresql.service

[Service]
Type=oneshot
User=moecish
Group=moecish
WorkingDirectory=/srv/moecish
EnvironmentFile=-/srv/moecish/.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/bin/bash -lc 'set -a; . /srv/moecish/.env; set +a; /usr/bin/npm run email:retry'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moecish-email-retry
